  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Service, index and portal-session health",
        "description": "Cheap by default (database + in-memory session state only). Add `?deep=true` to also exercise the portal login.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "Also log in to / ping the portal (generates portal traffic)"
            },
            "required": false,
            "description": "Also log in to / ping the portal (generates portal traffic)",
            "name": "deep",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Health report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Rebuild the local index from the portal",
        "description": "Re-reads ALL meters and the hierarchy from the portal (read-only towards the portal) and swaps them into MongoDB. Concurrent calls share one run.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "Block until the sync finishes (200) instead of returning 202 immediately"
            },
            "required": false,
            "description": "Block until the sync finishes (200) instead of returning 202 immediately",
            "name": "wait",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Finished (`wait=true`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "202": {
            "description": "Started or already running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "502": {
