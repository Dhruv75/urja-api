            "required": false,
            "description": "Comma-separated, e.g. `active,fault`",
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated, e.g. `single-phase`"
            },
            "required": false,
            "description": "Comma-separated, e.g. `single-phase`",
            "name": "type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
