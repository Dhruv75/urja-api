            "type": "string",
            "enum": [
              "fresh",
              "forced",
              "not_cached",
              "expired",
              "range_not_covered"
            ]
          },
          "droppedReadings": {
            "type": "integer",
            "description": "Portal rows that could not be parsed"
          },
          "warning": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
