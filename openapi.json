{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "version": "0.1.0",
    "description": "A clean, read-only REST API in front of the legacy Urja Meter Ops portal. Data is served from a local MongoDB index that is rebuilt from the portal; consumption is read through a cache. When `meta.source` is `fixture` the data is synthetic demo data."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Meters"
    },
    {
      "name": "Network"
    },
    {
      "name": "Operations"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "uptimeSec": {
            "type": "integer"
          },
          "source": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "fixture",
                  "portal"
                ]
              },
              "ok": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "null unless `?deep=true` was requested"
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "mode",
              "ok",
              "detail",
              "state"
            ]
          },
          "index": {
            "type": "object",
            "properties": {
              "sync": {
                "$ref": "#/components/schemas/SyncStatus"
              },
              "ageSeconds": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "stale": {
                "type": "boolean"
              }
            },
            "required": [
              "sync",
              "ageSeconds",
              "stale"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSec",
          "source",
          "index"
        ]
      },
      "SyncStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "never",
              "running",
              "ok",
              "error"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "counts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "startedAt",
          "finishedAt",
          "lastSuccessAt",
          "durationMs",
          "counts",
          "error"
        ]
      },
      "SyncResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SyncStatus"
          }
        },
        "required": [
          "data"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "MeterList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "meta": {
            "$ref": "#/components/schemas/IndexMeta"
          }
        },
        "required": [
          "data",
          "page",
          "meta"
        ]
      },
      "Meter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "MTR-000001"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "serialNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "description": "Trimmed and lower-cased; \"unknown\" when the portal gives none",
            "example": "active"
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lon"
            ]
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hierarchy node the meter hangs off; null when it cannot be placed"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {},
            "description": "Every other field the portal exposes, verbatim"
          },
          "dataQuality": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Issue codes found while cleaning this record (see /data-quality)"
          }
        },
        "required": [
          "id",
          "name",
          "serialNumber",
          "type",
          "status",
          "location",
          "nodeId",
          "attributes",
          "dataQuality"
        ]
      },
      "Page": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "limit",
          "offset",
          "total"
        ]
      },
      "IndexMeta": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "fixture",
              "portal"
            ],
            "description": "`fixture` means SYNTHETIC demo data, never the real portal"
          },
          "syncedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the local index was last rebuilt from the portal"
          },
          "stale": {
            "type": "boolean",
            "description": "True if the index is older than INDEX_TTL_SEC or the last sync failed"
          }
        },
        "required": [
          "source",
          "syncedAt",
          "stale"
        ]
      },
