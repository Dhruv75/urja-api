    "/api/v1/meters/{meterId}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Consumption time series",
        "description": "Interval energy, read through a cache. `meta.servedFrom` says whether the answer was fetched live from the source or came from the cache, `meta.ageSeconds` how old it is, and `meta.stale` whether it is out of date because the source failed. Windows touching \"now\" are trusted for 5 min, closed past windows for 24 h (configurable); `refresh=true` always asks the portal.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "MTR-000001"
            },
            "required": true,
            "name": "meterId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "ISO-8601 instant or date (no offset = UTC). Default: `to` minus 7 days",
              "example": "2026-10-01"
            },
            "required": false,
            "description": "ISO-8601 instant or date (no offset = UTC). Default: `to` minus 7 days",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Exclusive end. Default: now",
              "example": "2026-10-08T00:00:00Z"
            },
            "required": false,
            "description": "Exclusive end. Default: now",
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "raw",
                "hour",
                "day"
              ],
              "default": "hour",
              "description": "Aggregation bucket (UTC)"
            },
            "required": false,
            "description": "Aggregation bucket (UTC)",
            "name": "interval",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "Bypass the cache and ask the portal"
            },
            "required": false,
            "description": "Bypass the cache and ask the portal",
            "name": "refresh",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Time series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters (`validation_error`, `range_too_large`, ...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown meter / node (`not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The legacy portal failed, rejected our login, or is not mapped yet (`portal_unavailable`, `portal_auth_failed`, `portal_not_mapped`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
