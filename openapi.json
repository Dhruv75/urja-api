              "portal"
            ],
            "description": "Where the data originates (`fixture` = SYNTHETIC demo data)"
          },
          "servedFrom": {
            "type": "string",
            "enum": [
              "cache",
              "live"
            ],
            "description": "`live`: fetched from the source during this request. `cache`: answered from MongoDB."
