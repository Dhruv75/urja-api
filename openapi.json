              "from",
              "to",
              "points",
              "summary"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/ConsumptionMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ConsumptionPoint": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "string",
            "description": "Start of the interval, UTC"
          },
          "value": {
            "type": "number",
            "description": "Energy in the interval (`unit`)"
          },
          "samples": {
            "type": "integer",
            "description": "Readings summed into this bucket. A bucket with fewer samples than its neighbours is partial (window edge, or today so far); do not read it as a drop in consumption."
          }
        },
        "required": [
          "ts",
          "value",
