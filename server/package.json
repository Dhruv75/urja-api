{
  "name": "urja-api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean REST API in front of the Urja Meter Ops portal (Express + MongoDB index).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "test": "node --test --test-concurrency=1",
    "openapi": "node scripts/generate-openapi.js",
    "explore": "node --env-file-if-exists=../.env scripts/explore.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0"
  }
}
