# Copy to `.env` (git-ignored). Real environment variables override this file.

# ---- service ----
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/urja_api

# fixture = SYNTHETIC demo data, the portal is never contacted (default; the portal adapter is not mapped yet, see README)
# portal  = the real Urja Meter Ops portal
SOURCE_MODE=fixture

# ---- the real portal (used when SOURCE_MODE=portal, and by `npm run explore`) ----
# The credentials are in the take-home brief. They are intentionally NOT committed to this repo.
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=
PORTAL_PASSWORD=

# ---- optional tuning (defaults shown) ----
# PORTAL_TIMEOUT_MS=15000          per-request timeout
# PORTAL_MAX_RETRIES=3             transient failures (network, 429, 5xx), exponential backoff + Retry-After
# PORTAL_MAX_CONCURRENCY=2         parallel requests to the portal
# PORTAL_MIN_INTERVAL_MS=150       minimum gap between request starts (politeness)
# PORTAL_LOGIN_COOLDOWN_MS=60000   after a failed login, do not try again for this long (avoids lock-outs)
# READINGS_LIVE_TTL_SEC=300        consumption windows touching "now" are trusted this long
# READINGS_HISTORIC_TTL_SEC=86400  closed past windows are trusted this long
# INDEX_TTL_SEC=21600              meters + hierarchy are re-synced this often
# MAX_RANGE_DAYS=366               widest consumption window a caller may request
# WRITE_BATCH_SIZE=25              documents per MongoDB bulk write
# SYNC_ON_START=true               build/refresh the index at boot
# CORS_ORIGIN=http://localhost:5173
# LOG_LEVEL=info                   debug | info | warn | error | silent
